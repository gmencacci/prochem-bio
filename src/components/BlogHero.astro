---
// Hero del frame BLOG — verificado navegando Figma: eyebrow "Blog" +
// heading "Noticias" sobre una foto del equipo de Prochem Bio con cascos
// de seguridad (foto real provista por el usuario). No hay bajada/subtítulo
// debajo del heading en el diseño. Lleva una capa de degradé lineal por
// encima de la foto (de #D9D9D9 a #13322C) — valores exactos de Figma.
import { Image } from 'astro:assets';
import blogHero from '../assets/blog-hero.png';
---

<section class="relative flex min-h-[420px] items-end justify-center overflow-hidden pb-16 pt-24 sm:min-h-[714px] sm:pb-[161px]">
  <Image
    src={blogHero}
    alt="Equipo de Prochem Bio con cascos de seguridad"
    class="absolute inset-0 h-full w-full object-cover"
    widths={[640, 960, 1280, 1448]}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="eager"
    fetchpriority="high"
  />

  <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(19,50,44,0.95)_15%,rgba(255,255,255,0.25)_45%)]" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-[1280px] px-6 text-center sm:px-10 lg:px-[66px]">
    <p class="font-heading text-[20px] font-bold uppercase tracking-wide text-white">
      Blog
    </p>
    <p class="mt-3 font-heading text-[48px] font-bold leading-tight text-white">
      Noticias
    </p>
  </div>
</section>
