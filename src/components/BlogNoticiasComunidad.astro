---
// Primera grilla de tarjetas del frame BLOG — categoría "Comunidad", mismas
// 3 novedades y fotos ya usadas en la sección Noticias del Home (verificado
// que el contenido es idéntico). Sin heading propio: el "Blog"/"Noticias"
// ya está en BlogHero.astro, justo arriba de esta sección.
// Fondo crema + textura de círculos al 70% de opacidad (verificado con
// get_metadata, node 809:2435) — la textura es el mismo archivo que ya usa
// ContactoFormulario.astro (mismo hash, byte a byte), reusado acá.
import { Image } from 'astro:assets';
import patronFondo from '../assets/contacto-patron-fondo.png';

interface Noticia {
  tag: string;
  date: string;
  title: string;
  subtitle: string;
  description: string;
  image: string;
  alt: string;
  imagePosition?: string;
}

const noticias: Noticia[] = [
  {
    tag: 'Comunidad',
    date: '2025',
    title: 'Pecheras para los entrenamientos',
    subtitle: 'Juegos GEBO. 6to. Año Instituto Ramallo.',
    description:
      'Huellas que no se borran. Lo que se siembra con amor y esfuerzo, perduran en el tiempo y sigue dando frutos.',
    image: '/noticias-pecheras.png',
    alt: 'Equipo de chicos con pecheras de Prochem Bio en una cancha de fútbol',
  },
  {
    tag: 'Comunidad',
    date: '31 de Mayo, 2026.',
    title: 'Apoyo a la Escuela Técnica en la maratón.',
    subtitle: 'Escuela Secundaria Técnica N°1 "Bonifacio Velásquez".',
    description:
      'Creemos en el valor de la educación y el deporte como motores de crecimiento. Por eso apoyamos a la Escuela Secundaria Técnica N.° 1 en esta importante iniciativa.',
    image: '/noticias-maraton.png',
    alt: 'Mujer en el podio de una maratón sosteniendo una bandera de Prochem Bio',
    imagePosition: '50% 35%',
  },
  {
    tag: 'Comunidad',
    date: '22 de Mayo, 2026.',  
    title: 'Un compromiso que trasciende el campo',
    subtitle: 'Casa Familia, Rosario.',
    description:
      'Como parte de nuestro compromiso con la comunidad, acompañamos con la entrega de productos de limpieza e insumos para contribuir al bienestar de las familias que transitan este espacio.',
    image: '/noticias-donacion.png',
    alt: 'Publicación de Instagram de Casa Familia Rosario agradeciendo la donación de Prochem Bio',
  },
];
---

<section class="relative overflow-hidden bg-prochem-cream">
  <Image
    src={patronFondo}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-70"
    widths={[960, 1600]}
    sizes="100vw"
    format="webp"
    quality={70}
  />
  <div class="relative mx-auto w-full max-w-[1280px] px-6 py-20 sm:px-10 lg:px-[66px]">
    <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-3">
      {
        noticias.map((noticia) => (
          <article>
            <img
              src={noticia.image}
              alt={noticia.alt}
              loading="lazy"
              class="aspect-[3/2] w-full rounded-2xl object-cover"
              style={noticia.imagePosition ? `object-position: ${noticia.imagePosition};` : undefined}
            />
            <span class="mt-4 inline-block rounded-button bg-prochem-dark px-4 py-1.5 font-heading text-xs font-bold uppercase tracking-wide text-white">
              {noticia.tag}
            </span>
            <div class="mt-4">
              <p class="text-xs text-prochem-dark/60">{noticia.date}</p>
              <h3 class="mt-2 font-heading text-lg font-bold text-prochem-dark">
                {noticia.title}
              </h3>
              <p class="mt-1 text-sm font-bold text-prochem-accent">
                {noticia.subtitle}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-prochem-dark/70">
                {noticia.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
