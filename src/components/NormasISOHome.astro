---
// Sección "Normas ISO" del frame INICIO — va justo debajo de "Noticias".
// Verificada navegando el archivo real de Figma: heading centrado, grilla
// de 3 certificaciones TÜV NORD (imágenes reales que pasó el usuario, no
// recreadas por código) y debajo, una segunda grilla de 3 logos reales
// (CIAFA, CampoLimpio, Senasa).
interface Certificacion {
  src: string;
  alt: string;
}

const certificaciones: Certificacion[] = [
  { src: '/normas-tuvnord-iso14001.jpg', alt: 'TÜV NORD BRASIL - ISO 14001 - tuv-nord.com/br' },
  { src: '/normas-tuvnord-iso45001.jpg', alt: 'TÜV NORD CERT GmbH - ISO 45001 - tuev-nord.de' },
  { src: '/normas-tuvnord-iso9001.jpg', alt: 'TÜV NORD BRASIL - ISO 9001 - tuv-nord.com/br' },
];

interface Logo {
  src: string;
  alt: string;
}

const logos: Logo[] = [
  { src: '/normas-ciafa.png', alt: 'CIAFA - Cámara de la Industria Argentina de Fertilizantes y Agroquímicos' },
  { src: '/normas-campolimpio.png', alt: 'CampoLimpio - Programa de manejo de envases vacíos' },
  { src: '/normas-senasa.png', alt: 'SENASA - Servicio Nacional de Sanidad y Calidad Agroalimentaria' },
];
---

<section class="bg-white">
  <div class="mx-auto w-full max-w-[1280px] px-6 py-20 sm:px-10 lg:px-[66px]">
    <h2 class="text-center font-heading text-3xl font-bold leading-tight text-prochem-dark sm:text-4xl">
      <span class="font-normal">Normas</span> ISO
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        certificaciones.map((cert) => (
          <img
            src={cert.src}
            alt={cert.alt}
            loading="lazy"
            class="w-full rounded-card"
          />
        ))
      }
    </div>

    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        logos.map((logo) => (
          <div class="flex items-center justify-center rounded-card bg-prochem-accent/10 p-10">
            <img src={logo.src} alt={logo.alt} loading="lazy" class="h-16 w-auto object-contain" />
          </div>
        ))
      }
    </div>
  </div>
</section>
