---
// Footer real del frame INICIO (se repite igual en el resto de las páginas).
// Verificado navegando el archivo de Figma: 3 filas (logo+redes / contacto /
// enlaces), sin párrafo debajo del logo y sin línea de copyright — no
// estaban en el diseño real, se habían inventado en una versión anterior.
import Icon from './Icon.astro';

interface NavLink {
  label: string;
  href: string;
}

const links: NavLink[] = [
  { label: 'Home', href: '/' },
  { label: 'Productos', href: '/productos' },
  { label: 'Sobre Nosotros', href: '/nosotros' },
  { label: 'Blog', href: '/blog' },
];
---

<footer class="bg-prochem-dark">
  <div class="mx-auto w-full max-w-[1280px] px-6 py-16 sm:px-10 lg:px-[66px]">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <img src="/logo-footer.svg" alt="Prochem Bio - Industria Argentina" class="h-16 w-auto" />

      <div class="flex items-center gap-3">
        <a
          href="#"
          aria-label="LinkedIn"
          class="flex h-9 w-9 items-center justify-center rounded-md bg-prochem-accent text-white transition-opacity hover:opacity-80"
        >
          <Icon name="linkedin" class="h-4 w-4" />
        </a>
        <a
          href="#"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-md border border-white/40 text-white transition-colors hover:border-white"
        >
          <Icon name="instagram" class="h-4 w-4" />
        </a>
        <a
          href="#"
          aria-label="YouTube"
          class="flex h-9 w-9 items-center justify-center rounded-md border border-white/40 text-white transition-colors hover:border-white"
        >
          <Icon name="youtube" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-start justify-between gap-x-6 gap-y-6 text-sm text-white/80">
      <div class="flex items-start gap-2">
        <Icon name="map-pin" class="mt-0.5 h-6 w-6 shrink-0 text-white" />
        <span>
          Av. Azucena Villaflor 645, Parque Comirsa.<br />
          Ramallo (2915), Buenos Aires, Argentina.
        </span>
      </div>
      <div class="flex items-center gap-2">
        <Icon name="phone" class="h-6 w-6 shrink-0 text-white" />
        <span>+54 9 11 6462-8412</span>
      </div>
      <div class="flex items-center gap-2">
        <Icon name="mail" class="h-6 w-6 shrink-0 text-white" />
        <span>info@prochembio.com.ar</span>
      </div>
    </div>

    <hr class="mt-10 border-white/10" />

    <nav aria-label="Enlaces del sitio" class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="inline-flex items-center gap-1.5 text-sm text-white/80 transition-colors hover:text-white"
          >
            {link.label}
            <Icon name="external-link" class="h-3.5 w-3.5" />
          </a>
        ))
      }
    </nav>
  </div>
</footer>
