---
// Sección "Servicios" del frame INICIO — layout y copy verificados contra
// capturas reales de Figma que pasó el usuario.
//
// Layout real: dos columnas DESIGUALES (texto más ancho que la imagen,
// aprox. 1.4:1, no 50/50). Izquierda, eyebrow "Soluciones A Medida",
// heading, lista vertical sin tarjetas (ícono + título + descripción) y
// botón "Ver Más". Derecha, el collage de 5 fotos reales provistas por el
// usuario, ubicadas con las coordenadas EXACTAS del SVG que Figma exportó
// (viewBox 614x899): cada rectángulo ahí tenía una posición x/y/w/h fija,
// que acá se replica en % dentro de un contenedor con el mismo aspect-ratio
// — no son posiciones estimadas a ojo desde una captura.
import Icon from './Icon.astro';

interface Servicio {
  icon: 'globe' | 'filter' | 'droplet';
  title: string;
  description: string;
}

interface FotoCollage {
  src: string;
  alt: string;
  // Porcentajes recalculados sobre el bounding box REAL de las 5 fotos
  // (no sobre el viewBox completo del SVG, que tenía ~164px de margen
  // vacío arriba). Bounding box original en coords de Figma: x:[10,603.301]
  // y:[164,888.305] → ancho 593.301, alto 724.305. Así el conjunto de fotos
  // queda con el borde superior en 0%, alineado con "Soluciones a medida".
  left: string;
  top: string;
  width: string;
  height: string;
}

const fotosCollage: FotoCollage[] = [
  {
    src: '/servicios-foto-pipeta.png',
    alt: 'Control de calidad en laboratorio',
    left: '69.36%',
    top: '0%',
    width: '30.64%',
    height: '37.72%',
  },
  {
    src: '/servicios-foto-laboratorio.png',
    alt: 'Formulación en laboratorio con tabla periódica Prochem Bio',
    left: '34.68%',
    top: '21.26%',
    width: '30.64%',
    height: '37.72%',
  },
  {
    src: '/servicios-foto-campo.png',
    alt: 'Seguimiento a campo con tablet',
    left: '69.36%',
    top: '41.02%',
    width: '30.64%',
    height: '37.72%',
  },
  {
    src: '/servicios-foto-deposito.png',
    alt: 'Depósito de producto terminado',
    left: '0%',
    top: '48.12%',
    width: '30.64%',
    height: '37.72%',
  },
  {
    src: '/servicios-foto-control.png',
    alt: 'Sala de control de planta industrial',
    left: '34.68%',
    top: '62.28%',
    width: '30.64%',
    height: '37.72%',
  },
];

const servicios: Servicio[] = [
  {
    icon: 'globe',
    title: 'Producción para Terceros',
    description:
      'Desarrollo o transferencia de formulaciones. Producción bajo especificaciones del cliente. Fraccionado y packaging. Control de calidad y logística integrada.',
  },
  {
    icon: 'filter',
    title: 'Formulación y Fraccionado',
    description:
      'Escalado industrial. Adaptación a distintos formatos comerciales e industriales.',
  },
  {
    icon: 'droplet',
    title: 'Investigación y Desarrollo (I+D)',
    description:
      'Desarrollo de nuevos productos. Reformulación y optimización. Mejora de rendimiento técnico.',
  },
];
---

<section class="bg-white">
  <div class="mx-auto grid w-full max-w-[1280px] grid-cols-1 items-start gap-12 px-6 py-20 sm:px-10 lg:grid-cols-[1.4fr_1fr] lg:px-[66px]">
    <div>
      <p class="font-heading text-sm font-bold uppercase tracking-wide text-prochem-accent">
        Soluciones a medida
      </p>
      <h2 class="mt-3 font-heading text-3xl font-bold leading-tight text-prochem-dark sm:text-4xl">
        Servicios
      </h2>

      <div class="mt-10 space-y-8">
        {
          servicios.map((servicio) => (
            <div class="flex gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center text-prochem-dark">
                <Icon name={servicio.icon} class="h-6 w-6" />
              </span>
              <div class="max-w-[380px]">
                <h3 class="font-heading text-lg font-bold text-prochem-dark">
                  {servicio.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-prochem-dark/70">
                  {servicio.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <a
        href="/productos"
        class="ml-[60px] mt-8 inline-flex items-center gap-2 rounded-button bg-prochem-accent px-5 py-2.5 font-heading text-sm font-bold text-white transition-all hover:scale-105 hover:bg-prochem-yellow hover:text-prochem-dark"
      >
        Ver Más
        <Icon name="arrow-right-circle" class="h-4 w-4" />
      </a>
    </div>

    <div class="relative w-full self-start" style="aspect-ratio: 593.301 / 724.305;">
      {
        fotosCollage.map((foto) => (
          <img
            src={foto.src}
            alt={foto.alt}
            loading="lazy"
            class="absolute rounded-2xl object-cover"
            style={`left:${foto.left}; top:${foto.top}; width:${foto.width}; height:${foto.height};`}
          />
        ))
      }
    </div>
  </div>
</section>
