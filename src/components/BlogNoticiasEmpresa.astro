---
// Segunda grilla de tarjetas del frame BLOG — categoría "Empresa" (novedades
// corporativas), verificada navegando Figma. Nota: el título de la primera
// tarjeta decía "Expanción" en el archivo (typo real, falta la "s"); se
// corrigió a "Expansión" acá. Fondo verde oscuro + textura de círculos al
// 5% de opacidad (node 655:1997) + foto real de campo abajo (node 660:2000,
// 140px de alto).
import { Image } from 'astro:assets';
import patronFondo from '../assets/contacto-patron-fondo.png';
import plantines from '../assets/blog-empresa-plantines.png';

interface NoticiaEmpresa {
  tag: string;
  title: string;
  subtitle: string;
}

const noticias: NoticiaEmpresa[] = [
  {
    tag: 'Empresa',
    title: 'Expansión del centro Logístico',
    subtitle: '7.000 Posiciones de almacenamiento.',
  },
  {
    tag: 'Empresa',
    title: 'Crecimiento Sostenido',
    subtitle: 'En producción y facturación.',
  },
  {
    tag: 'Empresa',
    title: 'Incorporación',
    subtitle: 'Nuevas líneas productivas.',
  },
];
---

<section class="relative overflow-hidden bg-prochem-dark">
  <Image
    src={patronFondo}
    alt=""
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-5"
    widths={[960, 1600]}
    sizes="100vw"
    format="webp"
    quality={70}
  />
  <div class="relative mx-auto w-full max-w-[1280px] px-6 py-20 sm:px-10 lg:px-[66px]">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        noticias.map((noticia) => (
          <div class="rounded-card bg-white p-8">
            <span class="inline-block rounded-button bg-prochem-dark px-4 py-1.5 font-heading text-xs font-bold uppercase tracking-wide text-white">
              {noticia.tag}
            </span>
            <h3 class="mt-6 font-heading text-2xl font-bold leading-tight text-prochem-dark">
              {noticia.title}
            </h3>
            <p class="mt-2 text-sm font-bold text-prochem-accent">
              {noticia.subtitle}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <Image
    src={plantines}
    alt="Agricultor caminando junto a un tractor en un cultivo al atardecer"
    class="relative h-[140px] w-full object-cover object-bottom"
    widths={[640, 960, 1280, 1672]}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="lazy"
  />
</section>
