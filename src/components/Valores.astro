---
// Portado desde el bloque "recuadros valores2" (node 951:3547) del archivo de
// Figma: grilla de 6 tarjetas con ícono + título + descripción.
// Los íconos son SVGs propios estilo lucide (mismo lenguaje visual que usa el
// diseño); si preferís los íconos exactos, se pueden importar desde el
// paquete lucide-astro más adelante.

import Icon from './Icon.astro';

interface Valor {
  icon: string; // key para el switch de íconos abajo
  title: string;
  description: string;
}

const valores: Valor[] = [
  {
    icon: 'award',
    title: 'Excelencia Operativa',
    description:
      'Estandarización, control estadístico de procesos y mejora continua como ejes de la eficiencia corporativa.',
  },
  {
    icon: 'droplet',
    title: 'Sustentabilidad',
    description:
      'Gestión responsable de recursos, reducción del impacto ambiental y cumplimiento de normativas vigentes.',
  },
  {
    icon: 'filter',
    title: 'Innovación Tecnológica',
    description:
      'Aplicación sistemática de I+D para el desarrollo de nuevas formulaciones y optimización de procesos.',
  },
  {
    icon: 'users',
    title: 'Orientación al Cliente (B2B)',
    description:
      'Desarrollo de soluciones técnicas específicas conforme a requerimientos de cada cliente.',
  },
  {
    icon: 'git-pull-request',
    title: 'Agilidad Organizacional',
    description:
      'Capacidad de adaptación a variaciones en demanda, formulaciones y escalas productivas.',
  },
  {
    icon: 'shield',
    title: 'Mejora Continua',
    description:
      'Optimización de procesos y soluciones para alcanzar mayores niveles de calidad y eficiencia.',
  },
];
---

<section class="mx-auto w-full max-w-[1280px] px-6 py-20 sm:px-10 lg:px-[66px]">
  <h2 class="font-heading text-3xl font-bold text-prochem-dark sm:text-4xl">
    Nuestros valores
  </h2>

  <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      valores.map((valor) => (
        <article class="rounded-card border border-prochem-dark/10 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-prochem-accent/10 text-prochem-accent">
            <Icon name={valor.icon} />
          </span>
          <h3 class="mt-6 font-heading text-lg font-bold text-prochem-dark">
            {valor.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-prochem-dark/70">
            {valor.description}
          </p>
        </article>
      ))
    }
  </div>
</section>
