---
// Grilla "Valores Corporativos" (6 tarjetas) del frame NOSOTROS — verificada
// con get_design_context (node 951:3547 "recuadros valores2"). Flota sobre
// la parte inferior de la foto del Hero, mismo componente "Card" del design
// system que ValoresDestacados.astro usa en el Home (ahí solo se muestran 3
// de estas 6).
import Icon from './Icon.astro';

interface Valor {
  icon: 'award' | 'droplet' | 'filter' | 'users' | 'git-pull-request' | 'shield';
  title: string;
  description: string;
  theme: 'dark' | 'light' | 'yellow' | 'accent';
}

const valores: Valor[] = [
  {
    icon: 'award',
    title: 'Excelencia Operativa',
    description:
      'Estandarización, control estadístico de procesos y mejora continua como ejes de la eficiencia corporativa.',
    theme: 'dark',
  },
  {
    icon: 'droplet',
    title: 'Sustentabilidad',
    description:
      'Gestión responsable de recursos, reducción del impacto ambiental y cumplimiento de normativas vigentes.',
    theme: 'light',
  },
  {
    icon: 'filter',
    title: 'Innovación Tecnológica',
    description:
      'Aplicación sistemática de I+D para el desarrollo de nuevas formulaciones y optimización de procesos.',
    theme: 'yellow',
  },
  {
    icon: 'users',
    title: 'Orientación al Cliente (B2B)',
    description:
      'Desarrollo de soluciones técnicas específicas conforme a requerimientos de cada cliente.',
    theme: 'yellow',
  },
  {
    icon: 'git-pull-request',
    title: 'Agilidad Organizacional',
    description:
      'Capacidad de adaptación a variaciones en demanda, formulaciones y escalas productivas.',
    theme: 'accent',
  },
  {
    icon: 'shield',
    title: 'Mejora Continua',
    description:
      'Optimización de procesos y soluciones para alcanzar mayores niveles de calidad y eficiencia.',
    theme: 'dark',
  },
];

const themeClasses: Record<Valor['theme'], string> = {
  dark: 'bg-prochem-dark text-white',
  light: 'bg-white text-prochem-dark',
  yellow: 'bg-prochem-yellow text-prochem-dark',
  accent: 'bg-prochem-accent text-white',
};

const bodyThemeClasses: Record<Valor['theme'], string> = {
  dark: 'text-white/75',
  light: 'text-prochem-dark/70',
  yellow: 'text-prochem-dark/80',
  accent: 'text-white/85',
};
---

<section class="relative z-10 mt-[-60px] bg-transparent sm:mt-[-90px] lg:mt-[-140px]">
  <div class="mx-auto w-full max-w-[1280px] px-6 sm:px-10 lg:px-[66px]">
    <div class="grid grid-cols-1 gap-[10px] sm:grid-cols-3">
      {
        valores.map((valor) => (
          <div class={`flex flex-col gap-6 rounded-button p-6 ${themeClasses[valor.theme]}`}>
            <Icon name={valor.icon} class="h-8 w-8" />
            <div>
              <h3 class="text-[24px] font-bold leading-tight">{valor.title}</h3>
              <p class={`mt-3 text-[16px] leading-relaxed ${bodyThemeClasses[valor.theme]}`}>
                {valor.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
