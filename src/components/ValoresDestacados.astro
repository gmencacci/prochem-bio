---
// Franja de 3 valores del frame INICIO — versión reducida (3 de las 6
// tarjetas de "Valores Corporativos") que sobresalen por arriba de una foto
// de fondo a todo el ancho (primer plano de un brote, provista por el
// usuario): la mitad superior de cada tarjeta queda sobre fondo blanco, la
// mitad inferior sobre la foto. Título y descripción de cada tarjeta son
// idénticos a los de Valores.astro (mismo componente reutilizado en
// Figma), verificados contra el archivo.
import Icon from './Icon.astro';

interface Valor {
  icon: 'award' | 'droplet' | 'filter';
  title: string;
  description: string;
  theme: 'dark' | 'light' | 'accent';
}

const valores: Valor[] = [
  {
    icon: 'award',
    title: 'Excelencia Operativa',
    description:
      'Estandarización, control estadístico de procesos y mejora continua como ejes de la eficiencia corporativa.',
    theme: 'dark',
  },
  {
    icon: 'droplet',
    title: 'Sustentabilidad',
    description:
      'Gestión responsable de recursos, reducción del impacto ambiental y cumplimiento de normativas vigentes.',
    theme: 'light',
  },
  {
    icon: 'filter',
    title: 'Innovación Tecnológica',
    description:
      'Aplicación sistemática de I+D para el desarrollo de nuevas formulaciones y optimización de procesos.',
    theme: 'accent',
  },
];

const themeClasses: Record<Valor['theme'], string> = {
  dark: 'bg-prochem-dark text-white',
  light: 'bg-white text-prochem-dark',
  accent: 'bg-prochem-yellow text-prochem-dark',
};

const bodyThemeClasses: Record<Valor['theme'], string> = {
  dark: 'text-white/75',
  light: 'text-prochem-dark/70',
  accent: 'text-prochem-dark/80',
};
---

<section class="bg-white">
  <div class="relative z-10 mx-auto -mb-[130px] w-full max-w-[1280px] px-6 sm:px-10 lg:px-[66px]">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        valores.map((valor) => (
          <div class={`rounded-button px-8 py-10 ${themeClasses[valor.theme]}`}>
            <Icon name={valor.icon} class="h-8 w-8" />
            <h3 class="mt-6 font-heading text-[24px] font-bold">{valor.title}</h3>
            <p class={`mt-3 text-[16px] leading-relaxed ${bodyThemeClasses[valor.theme]}`}>
              {valor.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="h-64 w-full sm:h-72">
    <img
      src="/valores-destacados-fondo.jpg"
      alt="Brote de planta creciendo en la tierra"
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>
</section>
