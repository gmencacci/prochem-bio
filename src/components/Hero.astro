---
// Hero del frame "NOSOTROS" (Quienes Somos) en Figma — verificado con
// get_design_context (node 220:47): eyebrow "Valores Corporativos" + heading
// "Compromiso Prochem" (2 líneas), texto verde oscuro sobre la foto. Las 6
// tarjetas de Valores Corporativos (Valores.astro) flotan sobre la parte
// inferior de esta foto, mismo patrón que Categorias+ValoresDestacados en el
// Home.
import { Image } from 'astro:assets';
import heroCampo from '../assets/hero-campo.png';
---

<section class="relative flex min-h-[560px] items-center overflow-hidden pt-24 sm:min-h-[640px] lg:min-h-[799px]">
  <Image
    src={heroCampo}
    alt="Campo de cultivo, sector agroindustrial"
    class="absolute inset-0 h-full w-full object-cover"
    widths={[480, 640, 941]}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="eager"
    fetchpriority="high"
  />

  <div class="relative mx-auto w-full max-w-[1280px] px-6 sm:px-10 lg:px-[66px]">
    <div class="max-w-[541px] -mt-60">
      <p class="font-sans text-[20px] font-bold leading-7 tracking-normal capitalize text-prochem-dark">
        Valores Corporativos
      </p>
      <h1 class="mt-[39px] font-sans text-[42px] font-bold leading-[52px] tracking-normal capitalize text-prochem-dark sm:text-[64px] sm:leading-[78px]">
        Compromiso<br />
        Prochem
      </h1>
    </div>
  </div>
</section>
