---
// Portado desde el bloque hero de "NOSOTROS" (node 448:232 + 936:2718) del
// archivo de Figma. Imagen de fondo a sangre (1280x799 en el diseño) con
// overlay oscuro y bloque de título alineado a la izquierda.
//
// NOTA: el copy exacto y la tipografía puntual del título no se pudieron
// re-verificar contra Figma por un rate limit del conector — placeholder
// abajo, ajustar cuando se libere el acceso o si tenés el copy a mano.
---

<section class="relative flex min-h-[560px] items-center overflow-hidden sm:min-h-[640px] lg:min-h-[799px]">
  <img
    src="/hero-campo.png"
    alt="Campo de cultivo, sector agroindustrial"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Overlay oscuro para asegurar contraste del texto sobre la imagen -->
  <div class="absolute inset-0 bg-gradient-to-r from-prochem-dark/80 via-prochem-dark/50 to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-[1280px] px-6 sm:px-10 lg:px-[66px]">
    <div class="max-w-[541px]">
      <h1 class="font-heading text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-[56px]">
        Compromiso Prochem
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-white/90 sm:text-xl">
        <!-- placeholder: reemplazar con el copy real del subtítulo del Figma -->
        Más de 25 años desarrollando soluciones químicas para la industria
        agroindustrial argentina.
      </p>
    </div>
  </div>
</section>
