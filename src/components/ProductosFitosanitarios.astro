---
// Sección "Productos Fitosanitarios" del frame PRODUCTOS — heading y bajada
// verificados en Figma. La grilla de 4 categorías reutiliza el mismo
// componente Categorias.astro del Home (mismas fotos, íconos y botones
// "Ver Más"). Sin bg propio a propósito: el fondo (degradé + textura,
// compartido con ProductosIndustriales) vive en productos.astro.
import Categorias from './Categorias.astro';
---

<section>
  <div class="mx-auto w-full max-w-[1280px] px-6 pt-60 sm:px-10 lg:px-[66px]">
    <p class="font-sans text-[20px] font-bold leading-7 tracking-normal capitalize text-[#70b21c]">
      Servicios Y Productos
    </p>
    <h2 class="mt-3 font-sans text-[48px] font-bold leading-tight text-prochem-dark">
      Productos Fitosanitarios
    </h2>
    <p class="mt-4 max-w-[640px] text-base leading-relaxed text-prochem-dark/70">
      <span class="font-bold text-prochem-dark">Aplicación:</span> Protección
      de cultivos, optimización de absorción y eficiencia agronómica.
    </p>
  </div>

  <Categorias />
</section>
