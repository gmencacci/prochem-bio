---
// Hero del frame PRODUCTOS — verificado navegando Figma: eyebrow, heading y
// bajada son texto exacto. El fondo son DOS fotos apiladas sin espacio entre
// ellas (persona con guantes de nitrilo + hilera de cultivos) para que se
// vean como una sola imagen continua; las 3 tarjetas de Servicios (en
// ServiciosDetalle.astro) flotan encima, tapando la costura entre ambas.
---

<section class="relative overflow-hidden">
  <div class="relative">
    <img
      src="/productos-hero.png"
      alt="Persona con guantes de nitrilo trabajando en el laboratorio de Prochem Bio"
      class="h-[420px] w-full object-cover sm:h-[480px]"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-prochem-dark/70" aria-hidden="true"></div>

    <div class="absolute inset-0 flex items-center">
      <div class="mx-auto w-full max-w-[1280px] px-6 text-center sm:px-10 lg:px-[66px]">
        <p class="font-heading text-sm font-bold uppercase tracking-wide text-prochem-accent">
          Lo que hacemos
        </p>
        <h1 class="mt-3 font-heading text-4xl font-bold leading-tight text-white sm:text-5xl">
          Nuestros Servicios Y Productos
        </h1>
        <p class="mx-auto mt-5 max-w-[640px] text-base leading-relaxed text-white/80 sm:text-lg">
          Nos posicionamos como socios industrial de compañías nacionales e
          internacionales.
        </p>
      </div>
    </div>
  </div>

  <img
    src="/productos-hero-campo.png"
    alt="Hilera de cultivos en un campo agrícola"
    class="h-[280px] w-full object-cover sm:h-[300px]"
    loading="eager"
  />
</section>
