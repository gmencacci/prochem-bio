---
// Selector de categorías de producto del frame INICIO — reconstruido a
// partir de una captura del diseño real: cada tarjeta tiene una foto de
// fondo propia (tractor fumigando, aplicación aérea, campo) con overlay
// oscuro degradé, ícono insignia, título y botón "Ver Más".
//
// PENDIENTE: las 4 fotos de fondo son las reales del diseño y no se
// pudieron descargar desde Figma (rate limit del conector) — hoy son
// placeholders neutros marcados como tales, no fotos inventadas.
import Icon from './Icon.astro';

interface Categoria {
  icon: 'wheat' | 'flower' | 'bug' | 'leaf';
  label: string;
  href: string;
}

const categorias: Categoria[] = [
  { icon: 'wheat', label: 'Herbicidas', href: '/productos#herbicidas' },
  { icon: 'flower', label: 'Coadyuvantes', href: '/productos#coadyuvantes' },
  { icon: 'bug', label: 'Insecticidas', href: '/productos#insecticidas' },
  { icon: 'leaf', label: 'Fungicidas', href: '/productos#fungicidas' },
];
---

<section class="mx-auto w-full max-w-[1280px] px-6 py-12 sm:px-10 lg:px-[66px]">
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    {
      categorias.map((categoria) => (
        <a
          href={categoria.href}
          class="group relative flex aspect-[3/4] flex-col items-center justify-end overflow-hidden rounded-card bg-prochem-gray p-5 text-center"
        >
          {/* PENDIENTE: reemplazar por la foto real de fondo de esta categoría */}
          <div class="absolute inset-0 bg-gradient-to-b from-prochem-dark/10 via-prochem-dark/40 to-prochem-dark/80" aria-hidden="true" />

          <span class="relative mb-auto mt-6 flex h-14 w-14 items-center justify-center rounded-full bg-prochem-accent text-prochem-dark">
            <Icon name={categoria.icon} class="h-6 w-6" />
          </span>

          <span class="relative font-heading text-base font-bold text-white">
            {categoria.label}
          </span>
          <span class="relative mt-3 inline-flex items-center gap-1 rounded-lg bg-prochem-accent px-4 py-2 font-heading text-sm font-bold text-prochem-dark transition-transform group-hover:scale-105">
            Ver Más
            <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </span>
        </a>
      ))
    }
  </div>
</section>
