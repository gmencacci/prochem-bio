---
// Selector de categorías de producto del frame INICIO — cada tarjeta tiene
// foto de fondo propia con overlay oscuro degradé, ícono insignia real
// (provisto por el usuario, SVG exacto de Figma), título y botón "Ver Más"
// (layout verificado contra captura del diseño real).
// Fotos provistas por el usuario, en el orden real: Herbicidas, Coadyuvantes,
// Insecticidas, Fungicidas.
import Icon from './Icon.astro';

interface Categoria {
  icon:
    | 'badge-herbicidas'
    | 'badge-coadyuvantes'
    | 'badge-insecticidas'
    | 'badge-fungicidas';
  label: string;
  href: string;
  image: string;
}

const categorias: Categoria[] = [
  {
    icon: 'badge-herbicidas',
    label: 'Herbicidas',
    href: '/herbicidas',
    image: '/categoria-herbicidas.png',
  },
  {
    icon: 'badge-coadyuvantes',
    label: 'Coadyuvantes',
    href: '/coadyuvantes',
    image: '/categoria-coadyuvantes.png',
  },
  {
    icon: 'badge-insecticidas',
    label: 'Insecticidas',
    href: '/insecticidas',
    image: '/categoria-insecticidas.png',
  },
  {
    icon: 'badge-fungicidas',
    label: 'Fungicidas',
    href: '/fungicidas',
    image: '/categoria-fungicidas.png',
  },
];
---

<section class="mx-auto w-full max-w-[1280px] px-6 py-12 sm:px-10 lg:px-[66px]">
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    {
      categorias.map((categoria) => (
        <div class="relative flex aspect-[3/4] flex-col items-center justify-end overflow-hidden rounded-button p-5 text-center">
          <img
            src={categoria.image}
            alt={categoria.label}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(19,50,44,0.95)_0%,rgba(19,50,44,0)_55%)]" aria-hidden="true" />

          <Icon name={categoria.icon} class="relative h-14 w-14" />

          <span class="relative mt-4 font-heading text-base font-bold text-white">
            {categoria.label}
          </span>
          <a
            href={categoria.href}
            class="relative mt-3 inline-flex items-center gap-2 rounded-button bg-prochem-accent px-5 py-2.5 font-heading text-sm font-bold text-white transition-all hover:scale-105 hover:bg-prochem-yellow hover:text-prochem-dark"
          >
            Ver Más
            <Icon name="arrow-right-circle" class="h-4 w-4" />
          </a>
        </div>
      ))
    }
  </div>
</section>
