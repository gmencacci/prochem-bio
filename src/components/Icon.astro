---
// Set mínimo de íconos usado por Valores.astro, estilo lucide (stroke, 24x24).
// Si el proyecto crece, conviene migrar a un paquete real como lucide-astro;
// esto alcanza para no traer una dependencia extra por 6 íconos.

interface Props {
  name: 'award' | 'droplet' | 'filter' | 'users' | 'git-pull-request' | 'shield';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

{
  name === 'award' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
      <circle cx="12" cy="8" r="6" />
      <path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5" />
    </svg>
  )
}
{
  name === 'droplet' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
      <path d="M12 2.7s6 6.1 6 10.6a6 6 0 0 1-12 0c0-4.5 6-10.6 6-10.6Z" />
    </svg>
  )
}
{
  name === 'filter' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
      <path d="M22 3H2l8 9.5V19l4 2v-8.5L22 3Z" />
    </svg>
  )
}
{
  name === 'users' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </svg>
  )
}
{
  name === 'git-pull-request' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
      <circle cx="6" cy="6" r="3" />
      <circle cx="6" cy="18" r="3" />
      <path d="M6 9v6" />
      <path d="M18 9a3 3 0 0 0-3 3v0" />
      <circle cx="18" cy="6" r="3" />
    </svg>
  )
}
{
  name === 'shield' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
    </svg>
  )
}
