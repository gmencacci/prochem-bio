---
// Set mínimo de íconos usado por Valores.astro, estilo lucide (stroke, 24x24).
// Si el proyecto crece, conviene migrar a un paquete real como lucide-astro;
// esto alcanza para no traer una dependencia extra por 6 íconos.

interface Props {
  name:
    | 'award'
    | 'droplet'
    | 'filter'
    | 'users'
    | 'git-pull-request'
    | 'shield'
    | 'flask'
    | 'leaf'
    | 'factory'
    | 'target'
    | 'compass'
    | 'calendar'
    | 'badge-check'
    | 'map-pin'
    | 'phone'
    | 'mail'
    | 'linkedin'
    | 'instagram'
    | 'facebook'
    | 'youtube'
    | 'bug'
    | 'microscope'
    | 'arrow-right'
    | 'globe'
    | 'wheat'
    | 'flower';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
