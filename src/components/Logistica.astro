---
// Portado desde la captura "Logística Y Almacenamiento": imagen de fondo de
// depósito con overlay verde oscuro degradé, eyebrow + título + copy, línea
// separadora y 3 métricas destacadas.

interface Metrica {
  value: string;
  label: string;
}

const metricas: Metrica[] = [
  { value: '30.000.000', label: 'Millones de kilo litros anuales.' },
  { value: '8.000', label: 'Metros cuadrados cubiertos para almacenamiento.' },
  { value: '1.500', label: 'Metros cúbicos para almacenamiento a granel.' },
];
---

<section class="relative overflow-hidden">
  <img
    src="/logistica-deposito.png"
    alt="Depósito de almacenamiento Prochem Bio"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />

  <!-- Overlay: oscuro parejo a la izquierda para legibilidad del texto,
       degradé más fuerte hacia abajo (igual que en la captura) -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-prochem-dark/70 via-prochem-dark/50 to-prochem-dark/90"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1280px] px-6 py-20 sm:px-10 lg:px-[66px] lg:py-28">
    <div class="max-w-[600px]">
      <p class="font-heading text-sm font-bold uppercase tracking-wide text-white/90">
        Nuestro Espacio
      </p>

      <h2 class="mt-3 font-heading text-4xl font-bold leading-tight text-white sm:text-5xl">
        Logística Y Almacenamiento
      </h2>

      <p class="mt-6 text-base leading-relaxed text-white/85 sm:text-lg">
        Contamos con depósitos acondicionados para el almacenamiento de
        materia prima y productos terminados a granel y paletizados. Nos
        permite cumplir con nuestro compromiso de brindar recursos necesarios
        para alcanzar la satisfacción del cliente.
      </p>

      <hr class="mt-10 border-white/30" />

      <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-3">
        {
          metricas.map((metrica) => (
            <div>
              <p class="font-heading text-3xl font-bold text-white sm:text-4xl">
                {metrica.value}
              </p>
              <p class="mt-2 text-sm leading-snug text-white/80">
                {metrica.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
