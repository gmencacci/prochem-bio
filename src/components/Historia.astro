---
// "Una Historia De Crecimiento Y Evolución" — sección HISTORIA del frame
// NOSOTROS, re-verificada con get_design_context (node 843:8083): grilla de
// 2x2 tarjetas (no una línea de tiempo vertical), con eyebrow "Nuestra
// trayectoria". Orden real de Figma: [1998, 2007-2008] arriba, [2000, 2026]
// abajo.
//
// El hito "2000 · Implementación" no tiene copy propio confirmado en Figma
// (el mockup repite ahí, como placeholder, el mismo párrafo del hito de
// 1998) — se deja sin descripción en vez de inventar o reutilizar texto de
// otro hito.
// Sin bg propio a propósito: el fondo (crema + textura, nodes 644:1548 y
// 644:1549) vive en nosotros.astro.

interface Hito {
  year: string;
  title: string;
  description: string | null;
}

const hitos: Hito[] = [
  {
    year: '1998',
    title: 'Fundación',
    description:
      'El origen de Prochem Bio se remonta a hace más de veinticinco años, cuando en 1998 los hermanos Iván y Alfredo Marun emprendieron el desafío de crear una empresa dedicada a la producción y comercialización de productos auxiliares para la industria textil y papelera.',
  },
  {
    year: '2007 - 2008',
    title: 'Incorporación',
    description:
      'Con la incorporación al paquete accionario de los ingenieros Enrique Markman y Ernesto De la Canal. Este acontecimiento impulsó la apertura hacia un nuevo mercado: la producción de productos fitosanitarios.',
  },
  {
    year: '2000',
    title: 'Implementación',
    description: null,
  },
  {
    year: '2026',
    title: 'Actualidad',
    description:
      'Hoy la compañía se dedica al desarrollo, elaboración y comercialización de productos fitosanitarios y fertilizantes, operando desde su planta en el Parque Industrial COMIRSA, en la ciudad de Ramallo, provincia de Buenos Aires.',
  },
];
---

<section class="mx-auto w-full max-w-[1280px] px-6 py-20 sm:px-10 lg:px-[66px]">
  <div class="mx-auto max-w-[604px] text-center">
    <p class="font-sans text-[16px] font-bold leading-7 tracking-normal text-prochem-accent">
      Nuestra trayectoria
    </p>
    <h2 class="mt-[25px] font-sans text-[48px] font-bold leading-[65px] tracking-normal capitalize text-prochem-darker">
      Una historia de crecimiento y evolución
    </h2>
  </div>

  <div class="mt-[82px] grid grid-cols-1 gap-x-[47px] gap-y-6 sm:grid-cols-2">
    {
      hitos.map((hito) => (
        <div>
          <p class="font-heading text-sm font-bold text-prochem-dark">
            {hito.year} · {hito.title}
          </p>
          {hito.description && (
            <p class="mt-2 max-w-[392px] text-sm leading-relaxed text-prochem-dark/70">
              {hito.description}
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>
