---
// Página "Fungicidas" — corresponde al frame "FUNGICIDAS" de Figma
// (node 938:3381), 2 productos verificados contra el JSX real. Con esta se
// completan las 4 categorías (Herbicidas, Coadyuvantes, Insecticidas,
// Fungicidas) de la barra de navegación de productos.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CategoriaHero from '../components/CategoriaHero.astro';
import BarraCategoriasProductos from '../components/BarraCategoriasProductos.astro';
import CatalogoProductos, { type Producto } from '../components/CatalogoProductos.astro';
import Footer from '../components/Footer.astro';
import fungicidasHero from '../assets/fungicidas-hero.png';

const productos: Producto[] = [
  { nombre: 'CAMPO SEAL', lineas: ['Azoxistrobina 20% +', 'Ciproconazole 8% SC.'] },
  { nombre: 'CAMPO AZOXY 25', lineas: ['Azoxistrobina 25SC.'] },
];
---

<Layout title="Fungicidas">
  <Header />

  <main>
    <CategoriaHero
      titulo="Fungicidas"
      imagen={fungicidasHero}
      alt="Primer plano de hojas verdes"
      anchoNativo={675}
    />
    <BarraCategoriasProductos active="fungicidas" />
    <CatalogoProductos productos={productos} />
  </main>

  <Footer />
</Layout>
